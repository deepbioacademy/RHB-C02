data(airquality)
force(airquality)
View(airquality)
# View first 6 rows
head(airquality)
# View last 6 rows
tail(airquality)
# Dataset dimensions
dim(airquality)
# Column names
names(airquality)
# Structure
glimpse(airquality)
# Summary statistics
summary(airquality)
# Problem with missing values
mean(airquality$Temp)
mean(airquality$Ozone)
# How to deal with missing values
# 1. remove missing value
mean(airquality$Ozone, na.rm = T)
# How to deal with missing values?
# remove missing value
mean(airquality$Ozone, na.rm = T)
median(airquality$Ozone)
median(airquality$Ozone, na.rm = T)
# Find missing values
is.na(airquality)
# Count total missing values
sum(is.na(airquality))
# Find missing values per column
colSums(is.na(airquality))
# Find rows containing missing values
complete.case(airquality)
# Find rows containing missing values
airquality[!complete.cases(airquality), ]
# Find rows containing missing values
airquality
vect <- c(19, 20, 20)
vect[2]
# Find rows containing missing values
airquality[complete.cases(airquality), ]
# Find rows with no missing values
airquality[complete.cases(airquality), ]
!TRUE
# Find rows containing missing values
airquality[!complete.cases(airquality), ]
# which function
which(complete.cases(airquality))
which(!complete.cases(airquality))
# Find rows with no missing values
airquality[complete.cases(airquality), ]
which(complete.cases(airquality))
# Find rows containing missing values
airquality[!complete.cases(airquality), ]
which(!complete.cases(airquality))
# Find rows containing missing values
airquality[!complete.cases(airquality), ]
# Remove rows containing NA
airquality_clean <- na.omit(airquality)
sum(is.na(airquality_clean))
# imputation
# 2. if numeric variable (imputation)
# filling missing values with center (mean, median)
head(airquality)
# imputation
# 2. if numeric variable (imputation)
# filling missing values with center (mean, median)
mean(airquality$Ozone)
# imputation
# 2. if numeric variable (imputation)
# filling missing values with center (mean, median)
mean(airquality$Ozone, na.rm = T)
airquality |>
mutate(Ozone = ifelse(
is.na(Ozone),
mean(Ozone, na.rm = T),
Ozone
))
airquality_clean2 <- airquality |>
mutate(Ozone = ifelse(
is.na(Ozone),
mean(Ozone, na.rm = T),
Ozone
))
mean(airquality_clean2$Ozone)
colSums(airquality)
colSums(is.na(airquality_clean2))
airquality_clean2 <- airquality |>
mutate(Ozone = ifelse(
is.na(Ozone),
mean(Ozone, na.rm = T),
Ozone
)) |>
mutate(Solar.R = ifelse(
is.na(Solar.R),
mean(Solar.R, na.rm = T),
Solar.R
))
colSums(is.na(airquality_clean2))
