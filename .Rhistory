df1 <- data.frame(
ID = c(1, 2, 3, 4),
Name = c("A", "B", "C", "D")
)
df2 <- data.frame(
ID2 = c(1, 2, 3, 5),
Age = c(20, 25, 30, 35)
)
df1 |>
left_join(df2, by = c("ID" = "ID2"))
