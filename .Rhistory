cbind(df2)
# wide data
wide_df <- data.frame(
ID = c(1, 2, 3),
Name = c("A", "B", "C"),
Week1 = c(10, 20, 30),
Week2 = c(15, 25, 35),
Week3 = c(20, 30, 40)
)
View(wide_df)
# long data
wide_df |>
pivot_longer(
cols = 3:5,
names_to = "Week",
values_to = "Value"
)
# long data
long_df <- wide_df |>
pivot_longer(
cols = 3:5,
names_to = "Week",
values_to = "Value"
)
View(long_df)
# long to wide data
long_df |>
pivot_wider(
names_from = Week,
values_from = Value
)
